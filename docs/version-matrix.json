    {
      "id": "clash_api_cache_file",
      "kind": "removed",
      "deprecated_in": "1.8.0",
      "removed_in": "1.12.0",
      "path": "experimental.clash_api.cache_file",
      "replacement": "experimental.cache_file",
      "doc": "https://sing-box.sagernet.org/deprecated/#cache-file-and-related-features-in-clash-api"
    },
    {
      "id": "shadowsocksr_outbound",
      "kind": "removed",
      "deprecated_in": "1.5.0",
      "removed_in": "1.6.0",
